                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Dim_localidade Expandido\",{\"cod_matricula\", \"dt_matricula\", \"nacionalidade\", \"cod_turma\", \"nome_turma\", \"modalidade_turma\", \"sit_turma\", \"cod_curso\", \"nome_curso\", \"carga_horaria\", \"dt_fim\", \"instituicao\", \"municipio_pessoa\", \"uf_pessoa\", \"conteudista\", \"tematica\", \"codigo_pessoa\", \"sexo\", \"idade\", \"sit_matricula\", \"poder\", \"esfera\", \"email_pessoa\", \"telefone_pessoa\", \"email_conteudista\", \"Cod_localidade\"}),",
