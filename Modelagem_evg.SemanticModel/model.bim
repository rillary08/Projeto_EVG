                "    #\"Tipo Alterado1\" = Table.TransformColumnTypes(#\"Tipo Alterado\",{{\"dt_matricula\", type date}, {\"dt_fim\", type date}}),",
                "    #\"Texto Aparado\" = Table.TransformColumns(#\"Tipo Alterado1\",{{\"municipio_pessoa\", Text.Trim, type text}, {\"uf_pessoa\", Text.Trim, type text}}),",
                "    #\"Valor Substituído\" = Table.ReplaceValue(#\"Texto Aparado\",\"\",\"Desconhecido\",Replacer.ReplaceValue,{\"municipio_pessoa\", \"uf_pessoa\"}),",
                "    #\"Consultas Mescladas\" = Table.NestedJoin(#\"Valor Substituído\", {\"municipio_pessoa\", \"uf_pessoa\"}, Dim_localidade, {\"municipio_pessoa\", \"uf_pessoa\"}, \"Dim_localidade\", JoinKind.LeftOuter),",
