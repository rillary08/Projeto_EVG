                "let",
                "    Fonte = Csv.Document(File.Contents(\"C:\\Users\\rilla\\OneDrive\\Área de Trabalho\\Projeto_EVG\\data\\amostra_evg.csv\"),[Delimiter=\",\", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
