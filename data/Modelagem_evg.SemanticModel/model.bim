        "partitions": [
          {
            "name": "DCalendario",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = \"\",",
                "    DtMin = List.Min(amostra_evg[dt_matricula]),",
                "    DtMax = List.Max(amostra_evg[dt_matricula]),",
                "    Ndias = Duration.Days(DtMax - DtMin) +1,",
                "    ListaDatas = List.Dates(DtMin, Ndias, #duration(1,0,0,0)),",
                "    #\"Convertido para Tabela\" = Table.FromList(ListaDatas, Splitter.SplitByNothing(), null, null, ExtraValues.Error),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Convertido para Tabela\",{{\"Column1\", type date}}),",
                "    #\"Colunas Renomeadas\" = Table.RenameColumns(#\"Tipo Alterado\",{{\"Column1\", \"data\"}}),",
                "    #\"Ano Inserido\" = Table.AddColumn(#\"Colunas Renomeadas\", \"Ano\", each Date.Year([data]), Int64.Type),",
                "    #\"Mês Inserido\" = Table.AddColumn(#\"Ano Inserido\", \"Mês\", each Date.Month([data]), Int64.Type),",
                "    #\"Nome do Mês Inserido\" = Table.AddColumn(#\"Mês Inserido\", \"Nome do Mês\", each Date.MonthName([data]), type text),",
                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Nome do Mês Inserido\",{\"data\", \"Ano\", \"Nome do Mês\", \"Mês\"}),",
                "    #\"Trimestre Inserido\" = Table.AddColumn(#\"Colunas Reordenadas\", \"Trimestre\", each Date.QuarterOfYear([data]), Int64.Type),",
                "    #\"Dia Inserido\" = Table.AddColumn(#\"Trimestre Inserido\", \"Dia\", each Date.Day([data]), Int64.Type),",
                "    #\"Colunas Reordenadas1\" = Table.ReorderColumns(#\"Dia Inserido\",{\"data\", \"Ano\", \"Dia\", \"Nome do Mês\", \"Mês\", \"Trimestre\"}),",
                "    #\"Nome do Dia Inserido\" = Table.AddColumn(#\"Colunas Reordenadas1\", \"Nome do Dia\", each Date.DayOfWeekName([data]), type text),",
                "    #\"Colunas Reordenadas2\" = Table.ReorderColumns(#\"Nome do Dia Inserido\",{\"data\", \"Dia\", \"Nome do Dia\", \"Mês\", \"Nome do Mês\", \"Ano\", \"Trimestre\"})",
                "in",
                "    #\"Colunas Reordenadas2\""
              ],
              "type": "m"
            }
          }
        ]
      },
