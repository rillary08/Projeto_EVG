              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(\"C:\\Users\\rillary.lorranne\\Downloads\\amostra_evg.csv\"),[Delimiter=\",\", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
